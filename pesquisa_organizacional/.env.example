# ===========================================================================
# Variáveis de ambiente do Dashboard de Clima Organizacional (v2)
#
# Copie este arquivo para `.env` na raiz do projeto e preencha os valores.
# O arquivo `.env` NUNCA deve ser versionado (já está no .gitignore).
# ===========================================================================

# --- Servidor -------------------------------------------------------------
# Porta HTTP em que o dashboard responde. O servidor escuta em 0.0.0.0 para
# ficar acessível aos outros computadores da rede interna.
PORT=8080

# --- Banco de dados MySQL -------------------------------------------------
# Use o usuário de privilégio mínimo criado no README_V2.md — nunca o root.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=clima_app
DB_PASSWORD=troque-esta-senha
DB_NAME=clima_organizacional

# --- Sessão ---------------------------------------------------------------
# Segredo usado para assinar o cookie de sessão. Gere um valor longo e
# aleatório, por exemplo com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Trocar este valor invalida todas as sessões ativas (todos precisam logar
# de novo) — o que é o comportamento desejado se ele for comprometido.
SESSION_SECRET=troque-por-um-valor-longo-e-aleatorio

# --- Admin inicial (bootstrap) -------------------------------------------
# Na primeira subida do servidor, se não existir NENHUM admin no banco, esta
# conta é criada automaticamente. Troque a senha no primeiro login.
#
# A entrada no sistema é por NOME DE CADASTRO + senha. ADMIN_USUARIO é esse nome
# de cadastro: letras sem acento, números, ponto, hífen e sublinhado, sem espaços.
ADMIN_USUARIO=admin
ADMIN_SENHA_INICIAL=troque-esta-senha-no-primeiro-acesso
ADMIN_NOME=Administrador do Sistema

# E-mail é OPCIONAL (apenas contato, não serve para entrar). Pode ficar em branco
# ou ser removido. Se ADMIN_USUARIO não for definido, o nome de cadastro é
# derivado da parte antes do @ deste e-mail.
ADMIN_EMAIL=
